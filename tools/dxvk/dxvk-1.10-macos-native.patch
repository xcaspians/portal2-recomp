@@ -1,23 +1,31 @@
 project('dxvk', ['c', 'cpp'], version : 'v1.10.3', meson_version : '>= 0.49', default_options : [ 'cpp_std=c++17' ])
 
+# DXVK 1.10.x (Gcenx/DXVK-macOS) with dxvk-native's 1.x non-Windows build
+# carried over: Windows builds as before; anything else builds natively,
+# with SDL2 for windows and the Vulkan library given by -Dnative_vulkan_lib
+# (MoltenVK on macOS, for P2CE: docs/fork/P2CE_RENDERER_DECISION.md).
+
 cpu_family = target_machine.cpu_family()
 platform   = target_machine.system()
 
 cpp = meson.get_compiler('cpp')
 cc = meson.get_compiler('c')
+dxvk_compiler = cpp
 dxvk_is_msvc = cpp.get_id() == 'msvc'
+dxvk_cpp_std = 'c++17'
+dxvk_native = platform != 'windows'
 
 compiler_args = [
-  '-msse',
-  '-msse2',
-  '-msse3',
-  '-mfpmath=sse',
   '-Wimplicit-fallthrough',
   # clang
   '-Wno-unused-private-field',
   '-Wno-microsoft-exception-spec',
 ]
 
+if cpu_family == 'x86' or cpu_family == 'x86_64'
+  compiler_args += [ '-msse', '-msse2', '-msse3', '-mfpmath=sse' ]
+endif
+
 link_args = []
 
 if get_option('build_id')
@@ -26,6 +34,8 @@ if get_option('build_id')
   ]
 endif
 
+dxvk_extradep = [ ]
+
 if platform == 'windows'
   compiler_args += [
     '-DNOMINMAX',
@@ -84,9 +94,31 @@ if platform == 'windows'
   endif
 
   dxvk_include_path = include_directories('./include')
-
-  dxvk_wsi = 'win32'
+  dxvk_wsi      = 'win32'
+  dxvk_platform = 'windows'
+  so_prefix     = ''
+  lib_vulkan    = []
+  lib_sdl2      = []
   compiler_args += ['-DDXVK_WSI_WIN32']
+else
+  # Native (dxvk-native 1.x): Windows types and DirectX headers from
+  # include/native, SDL2 windows, the Vulkan library linked directly.
+  compiler_args += [ '-DDXVK_NATIVE', '-DDXVK_WSI_SDL2', '-DDXVK_PLATFORM_' + platform.to_upper() ]
+  dxvk_include_path = include_directories('./include', './include/native/', './include/native/windows', './include/native/directx')
+  dxvk_wsi      = 'sdl2'
+  dxvk_platform = platform
+  so_prefix     = 'libdxvk_'
+  lib_vulkan    = cpp.find_library(get_option('native_vulkan_lib'))
+  lib_sdl2      = cpp.find_library('SDL2')
+  lib_dxgi      = []
+  res_ext       = ''
+  wrc = find_program('echo')
+  wrc_generator = generator(wrc,
+    output    : [ '@BASENAME@_ignored.h' ],
+    arguments : [ 'Ignoring: ', '@INPUT@' ])
+  if platform == 'linux'
+    dxvk_extradep += [ cpp.find_library('dl') ]
+  endif
 endif
 
 add_project_arguments(cpp.get_supported_arguments(compiler_args), language: 'cpp')
